{
  "name": "telestick",
  "version": "1.0.0",
  "description": "Forward Telegram stickers to WhatsApp through a compatible messaging gateway.",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.23.0"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/convert/tgs_render.py dist/convert/tgs_render.py",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "grammy": "1.46.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "author": "iiroak",
  "license": "MIT"
}
