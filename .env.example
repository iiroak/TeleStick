# Create a bot with @BotFather and enter the token here.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Comma-separated Telegram user IDs allowed to use the bot.
ALLOWED_TELEGRAM_USER_IDS=replace-with-your-telegram-user-id

# Base URL and Bearer API key for a compatible WhatsApp messaging gateway.
HUB_BASE_URL=https://whatsapp-hub.example.com
HUB_API_KEY=replace-with-a-whatsapp-hub-api-key
HUB_SESSION_ID=main

# Optional comma-separated destinations seeded only when the database is empty.
# Destinations can also be managed with /destinations and /add.
DEFAULT_DESTINATIONS=
# Optional calling code (digits only) for national-format phone numbers.
# Leave empty to require international numbers starting with +.
DEFAULT_COUNTRY_CODE=

DATA_DIR=./data
LOG_LEVEL=info
PORT=3000
HEALTH_BIND_ADDR=127.0.0.1
HUB_TIMEOUT_MS=15000
HUB_MAX_RETRIES=2
HUB_RETRY_BASE_MS=500
TELEGRAM_DOWNLOAD_TIMEOUT_MS=30000
MAX_STICKER_DOWNLOAD_BYTES=5000000
TGS_MAX_FRAMES=300
TGS_RENDER_TIMEOUT_MS=30000
FFMPEG_TIMEOUT_MS=30000
CWEBP_TIMEOUT_MS=15000
IMG2WEBP_TIMEOUT_MS=30000
